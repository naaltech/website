---
import Icon from "@/components/Icon.astro"

interface Props {
  name: string
  title: string
}

const { name, title } = Astro.props
---

<details name={name} class="group border-b last:border-b-0">
  <summary class="focus-visible:border-ring focus-visible:ring-ring/50 flex cursor-pointer list-none items-start justify-between gap-4 rounded-md py-4 text-left text-sm font-medium transition-all outline-none hover:underline focus-visible:ring-[3px] [&::-webkit-details-marker]:hidden">
    {title}
    <Icon name="chevron-down" class="text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200 group-open:rotate-180" />
  </summary>
  <div class="pt-0 pb-4 text-sm text-gray-600">
    <slot />
  </div>
</details>
