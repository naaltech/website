---
const icons = import.meta.glob<string>("/node_modules/heroicons/24/outline/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
})

interface Props {
  name: string
  class?: string
}

const { name, class: className } = Astro.props
const svg = icons[`/node_modules/heroicons/24/outline/${name}.svg`]
if (!svg) {
  throw new Error(`Unknown heroicon: ${name}`)
}
const html = svg.replace(' data-slot="icon"', "").replace("<svg ", `<svg class="${className ?? ""}" `)
---

<Fragment set:html={html} />
