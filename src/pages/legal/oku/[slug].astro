---
import type { GetStaticPaths } from "astro"
import Layout from "@/layouts/Layout.astro"
import PdfReader from "@/components/PdfReader.astro"
import { documentFileUrl, legalDocuments, type LegalDocument } from "@/lib/legal-documents"

export const getStaticPaths = (() =>
  legalDocuments.map((document) => ({
    params: { slug: document.slug },
    props: { document },
  }))) satisfies GetStaticPaths

interface Props {
  document: LegalDocument
}

const { document } = Astro.props
---

<Layout title={document.title} description={document.description}>
  <section class="py-10">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <a href="/legal/" class="text-sm font-medium text-gray-600 hover:text-gray-900">
        ← Yasal belgeler
      </a>
      <h1 class="mt-4 text-3xl font-bold text-gray-900">{document.title}</h1>
      <p class="mt-2 mb-6 text-gray-600">{document.description}</p>
      <PdfReader fileUrl={documentFileUrl(document.filename)} filename={document.filename} />
    </div>
  </section>
</Layout>
